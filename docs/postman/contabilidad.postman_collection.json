              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Datos únicos en cada ejecución.",
                  "const sufijo = Date.now();",
                  "pm.collectionVariables.set('eventId', 'evt-pm-' + pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('numeroOrden', 'ORD-PM-' + sufijo);",
                  "pm.collectionVariables.set('vendedor1', 'V-PM-' + sufijo + '-1');",
                  "pm.collectionVariables.set('vendedor2', 'V-PM-' + sufijo + '-2');",
                  "pm.collectionVariables.set('ahoraIso', new Date().toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('Resultado PROCESADO', () => pm.expect(pm.response.json().resultado).to.eql('PROCESADO'));"
                ]
