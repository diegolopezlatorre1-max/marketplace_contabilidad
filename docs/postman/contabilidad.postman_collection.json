        {
          "name": "Vigencia solapada -> 409",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/comisiones/configuracion",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "comisiones",
                "configuracion"
