    {
      "name": "2. HU-CON-09 Comisión",
      "item": [
        {
          "name": "Consultar comisión vigente (contador)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/comisiones/configuracion",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "comisiones",
                "configuracion"
              ]
            },
            "description": "Guarda el % vigente y el inicio de la vigencia abierta para los siguientes pasos.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenContador}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('Hay un porcentaje vigente', () => pm.expect(r.vigente).to.not.eql(null));",
                  "pm.collectionVariables.set('porcentajeVigente', r.vigente.porcentaje);",
                  "// Inicio de la vigencia abierta: una nueva debe empezar después.",
                  "const abierta = r.historial.find((v) => v.vigenteHasta === null);",
                  "pm.collectionVariables.set('inicioVigenciaAbierta', abierta.vigenteDesde);"
                ]
              }
            }
          ]
        },
        {
          "name": "Configurar como contador -> 403",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/comisiones/configuracion",
              "host": [
                "{{baseUrl}}"
              ],
