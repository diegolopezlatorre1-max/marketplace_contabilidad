                  "value": "{{tokenContador}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"porcentaje\": \"12\",\n  \"vigenteDesde\": \"2030-01-01\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
