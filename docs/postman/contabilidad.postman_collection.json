                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"porcentaje\": \"12\",\n  \"vigenteDesde\": \"{{inicioVigenciaAbierta}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 409', () => pm.response.to.have.status(409));",
                  "pm.test('Código CONFLICTO', () => pm.expect(pm.response.json().code).to.eql('CONFLICTO'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Configurar como administrador (mismo %) -> 200",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/comisiones/configuracion",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "comisiones",
                "configuracion"
              ]
            },
            "description": "Registra el MISMO porcentaje vigente en la siguiente fecha válida: demuestra el cierre de la vigencia anterior sin cambiar el % de la BD de desarrollo, así la colección se puede ejecutar varias veces. Para cambiar el % de verdad, edite el cuerpo.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"porcentaje\": \"{{porcentajeVigente}}\",\n  \"vigenteDesde\": \"{{fechaNuevaVigencia}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Siguiente fecha válida: hoy (hora de Colombia) o el día después del inicio de la vigencia abierta.",
                  "const hoy = new Date(Date.now() - 5 * 3600 * 1000).toISOString().slice(0, 10);",
                  "const inicio = pm.collectionVariables.get('inicioVigenciaAbierta');",
                  "const siguiente = new Date(inicio + 'T00:00:00Z');",
                  "siguiente.setUTCDate(siguiente.getUTCDate() + 1);",
                  "const minimo = siguiente.toISOString().slice(0, 10);",
                  "pm.collectionVariables.set('fechaNuevaVigencia', hoy > minimo ? hoy : minimo);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "const fecha = pm.collectionVariables.get('fechaNuevaVigencia');",
                  "pm.test('La nueva vigencia queda abierta', () => {",
                  "  const nueva = r.historial.find((v) => v.vigenteDesde === fecha);",
                  "  pm.expect(nueva.vigenteHasta).to.eql(null);",
                  "  pm.expect(nueva.creadoPor).to.eql('u-admin');",
                  "});",
                  "pm.test('La anterior se cerró el día previo', () => {",
                  "  const d = new Date(fecha + 'T00:00:00Z'); d.setUTCDate(d.getUTCDate() - 1);",
                  "  const anterior = r.historial.find((v) => v.vigenteDesde === pm.collectionVariables.get('inicioVigenciaAbierta'));",
                  "  pm.expect(anterior.vigenteHasta).to.eql(d.toISOString().slice(0, 10));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
