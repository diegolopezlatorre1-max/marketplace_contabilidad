# Entorno: development | test | production
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL (el esquema "contabilidad" lo crean las migraciones)
DATABASE_URL=postgres://postgres:CAMBIAR_PASSWORD@localhost:5432/marketplace_contabilidad
# En Supabase: botón "Connect" -> Session pooler (puerto 5432), con el usuario y la contraseña que
# entregue el administrador del proyecto. Es un SECRETO: solo aquí y en las variables de Render.
#   DATABASE_URL=postgresql://<usuario>.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# TLS hacia PostgreSQL: disable (local) | verify (Supabase) | no-verify
DATABASE_SSL=disable
# Certificado de la CA en PEM (Supabase: Database Settings -> SSL), con "
" en una sola línea.
DATABASE_SSL_CA=
# BD para pruebas de integración (npm run test:integration)
TEST_DATABASE_URL=postgres://postgres:CAMBIAR_PASSWORD@localhost:5432/marketplace_contabilidad_test

# Adaptadores de integración con otros módulos: mock | http | events
INTEGRATION_MODE=mock
# Autenticación de usuarios: mock (tokens de desarrollo) | supabase (Supabase Auth)
AUTH_MODE=mock
# Proyecto Supabase compartido del marketplace (Project Settings -> API). Solo con AUTH_MODE=supabase.
# La publishable key (o anon key) es pública; NO use aquí la secret/service_role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Claves de los módulos que envían eventos (cabecera x-api-key), "modulo:clave" separados por coma.
# Secreto: cada módulo recibe solo la suya. Obligatorio en producción. Ejemplo:
#   SERVICE_API_KEYS=ordenes:<clave-larga-aleatoria>,pagos:<otra-clave>
SERVICE_API_KEYS=

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173
