# Entorno: development | test | production
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL (el esquema "contabilidad" lo crean las migraciones)
DATABASE_URL=postgres://postgres:CAMBIAR_PASSWORD@localhost:5432/marketplace_contabilidad
# BD para pruebas de integración (npm run test:integration)
TEST_DATABASE_URL=postgres://postgres:CAMBIAR_PASSWORD@localhost:5432/marketplace_contabilidad_test

# Adaptadores de integración con otros módulos: mock | http | events
INTEGRATION_MODE=mock
# Autenticación: mock (tokens de desarrollo) | jwt (token del marketplace, Fase 6)
AUTH_MODE=mock

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173
